# Runs at CTest startup, so rebuilding automatically refreshes the inventory.
include("${CMAKE_CURRENT_LIST_DIR}/Baro.cmake")
function(_baro_discover)
cmake_policy(PUSH)
cmake_policy(VERSION 3.20)
if(NOT EXISTS "${BARO_EXECUTABLE}")
    _baro_code_quote(name "${BARO_TEST_PREFIX}NOT_BUILT${BARO_TEST_SUFFIX}")
    _baro_code_quote(cmake "${BARO_CMAKE_COMMAND}")
    cmake_language(EVAL CODE "add_test(${name} ${cmake} -E false)")
    cmake_policy(POP)
    return()
endif()

# IDE discovery can overlap a command-line CTest invocation.
file(LOCK "${BARO_OUTPUT}.lock" GUARD FUNCTION TIMEOUT "${BARO_DISCOVERY_TIMEOUT}" RESULT_VARIABLE lock_result)
if(NOT "${lock_result}" STREQUAL "0")
    message(FATAL_ERROR "Could not lock Baro discovery: ${lock_result}")
endif()

_baro_code_quote(command "${BARO_CMAKE_COMMAND}")
string(APPEND command " -E env")
if(BARO_ENVIRONMENT_COUNT GREATER 0)
    math(EXPR last "${BARO_ENVIRONMENT_COUNT} - 1")
    foreach(index RANGE 0 ${last})
        _baro_code_quote(value "${BARO_ENVIRONMENT_${index}}")
        string(APPEND command " ${value}")
    endforeach()
endif()
set(test_command "")
if(BARO_EMULATOR_COUNT GREATER 0)
    math(EXPR last "${BARO_EMULATOR_COUNT} - 1")
    foreach(index RANGE 0 ${last})
        _baro_code_quote(value "${BARO_EMULATOR_${index}}")
        string(APPEND test_command " ${value}")
    endforeach()
endif()
_baro_code_quote(exe "${BARO_EXECUTABLE}")
string(APPEND test_command " ${exe}")
string(APPEND command " -- ${test_command}")
_baro_code_quote(directory "${BARO_WORKING_DIRECTORY}")
cmake_language(EVAL CODE "execute_process(COMMAND ${command} --list-tests-json --allow-empty
    WORKING_DIRECTORY ${directory} TIMEOUT ${BARO_DISCOVERY_TIMEOUT}
    RESULT_VARIABLE status OUTPUT_VARIABLE inventory ERROR_VARIABLE errors)")
if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Baro discovery failed (${status}) for ${BARO_EXECUTABLE}:\n${inventory}${errors}")
endif()
string(JSON version_type ERROR_VARIABLE json_error TYPE "${inventory}" version)
string(JSON version ERROR_VARIABLE json_error GET "${inventory}" version)
if(json_error OR NOT version_type STREQUAL "NUMBER" OR NOT "${version}" STREQUAL "1")
    message(FATAL_ERROR "Unsupported or malformed Baro discovery inventory: ${inventory}")
endif()
string(JSON kind ERROR_VARIABLE json_error TYPE "${inventory}" tests)
if(json_error OR NOT kind STREQUAL "ARRAY")
    message(FATAL_ERROR "Baro inventory tests must be an array")
endif()
string(JSON count LENGTH "${inventory}" tests)
_baro_code_quote(runner "${BARO_RUNNER}")
set(generated "# Generated by Baro; refreshed at CTest startup.\n")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    # Count identities without using descriptions/paths as CMake list elements.
    foreach(index RANGE 0 ${last})
        foreach(field id line name file expect_abort tags)
            string(JSON kind ERROR_VARIABLE error TYPE "${inventory}" tests ${index} ${field})
            set(expected STRING)
            if(field STREQUAL "id" OR field STREQUAL "line")
                set(expected NUMBER)
            elseif(field STREQUAL "expect_abort")
                set(expected BOOLEAN)
            elseif(field STREQUAL "tags")
                set(expected ARRAY)
            endif()
            if(error OR NOT kind STREQUAL expected)
                message(FATAL_ERROR "Invalid Baro inventory field ${field} in test ${index}")
            endif()
        endforeach()
        string(JSON id GET "${inventory}" tests ${index} id)
        string(JSON line GET "${inventory}" tests ${index} line)
        if(NOT id MATCHES "^[1-9][0-9]*$" OR NOT line MATCHES "^[1-9][0-9]*$")
            message(FATAL_ERROR "Invalid Baro test ID or line")
        endif()
        if(DEFINED id_${id})
            message(FATAL_ERROR "Duplicate Baro test ID: ${id}")
        endif()
        set(id_${id} TRUE)
        string(JSON tag_count LENGTH "${inventory}" tests ${index} tags)
        if(tag_count GREATER 0)
            math(EXPR tag_last "${tag_count} - 1")
            foreach(tag RANGE 0 ${tag_last})
                string(JSON kind TYPE "${inventory}" tests ${index} tags ${tag})
                if(NOT kind STREQUAL "STRING")
                    message(FATAL_ERROR "Invalid Baro tag in test ${index}")
                endif()
            endforeach()
        endif()
        string(JSON name GET "${inventory}" tests ${index} name)
        string(JSON source GET "${inventory}" tests ${index} file)
        if(IS_ABSOLUTE "${source}")
            file(RELATIVE_PATH source "${BARO_SOURCE_DIRECTORY}" "${source}")
        endif()
        string(REPLACE "\\" "/" source "${source}")
        string(SHA256 name_key "${name}")
        string(SHA256 file_key "${name_key}:${source}")
        if(NOT DEFINED names_${name_key})
            set(names_${name_key} 0)
        endif()
        if(NOT DEFINED files_${file_key})
            set(files_${file_key} 0)
            set(seen_${file_key} 0)
        endif()
        math(EXPR names_${name_key} "${names_${name_key}} + 1")
        math(EXPR files_${file_key} "${files_${file_key}} + 1")
        set(source_${index} "${source}")
        set(name_key_${index} "${name_key}")
        set(file_key_${index} "${file_key}")
    endforeach()
    foreach(index RANGE 0 ${last})
        foreach(key id name file line expect_abort)
            string(JSON ${key} GET "${inventory}" tests ${index} ${key})
        endforeach()
        if(NOT id MATCHES "^[1-9][0-9]*$")
            message(FATAL_ERROR "Invalid Baro test ID: ${id}")
        endif()
        set(identity "${name}")
        set(name_key "${name_key_${index}}")
        set(file_key "${file_key_${index}}")
        if(names_${name_key} GREATER 1)
            set(discriminator "${source_${index}}")
            if(files_${file_key} GREATER 1)
                math(EXPR seen_${file_key} "${seen_${file_key}} + 1")
                string(APPEND discriminator " #${seen_${file_key}}")
            endif()
            string(APPEND identity " [${discriminator}]")
        endif()
        string(SHA256 identity_key "${identity}")
        if(DEFINED identity_${identity_key})
            message(FATAL_ERROR "CTest name collision: ${identity}; rename the conflicting tests")
        endif()
        set(identity_${identity_key} TRUE)
        _baro_code_quote(test_name "${BARO_TEST_PREFIX}${identity}${BARO_TEST_SUFFIX}")
        string(APPEND generated "add_test(${test_name} ${runner} ${test_command} --test-id ${id} --diagnostics compiler --ctest")
        if(BARO_EXTRA_ARGS_COUNT GREATER 0)
            math(EXPR extra_last "${BARO_EXTRA_ARGS_COUNT} - 1")
            foreach(extra RANGE 0 ${extra_last})
                _baro_code_quote(value "${BARO_EXTRA_ARGS_${extra}}")
                string(APPEND generated " ${value}")
            endforeach()
        endif()
        string(APPEND generated ")\nset_tests_properties(${test_name} PROPERTIES WORKING_DIRECTORY ${directory}")
        if(NOT "${BARO_TIMEOUT}" STREQUAL "")
            string(APPEND generated " TIMEOUT ${BARO_TIMEOUT}")
        endif()
        # Encode list properties without splitting semicolons inside one value.
        foreach(key ENVIRONMENT LABELS)
            set(values "")
            if(BARO_${key}_COUNT GREATER 0)
                math(EXPR value_last "${BARO_${key}_COUNT} - 1")
                foreach(item RANGE 0 ${value_last})
                    string(REPLACE ";" "\\;" value "${BARO_${key}_${item}}")
                    list(APPEND values "${value}")
                endforeach()
            endif()
            if(key STREQUAL "LABELS")
                string(JSON tags LENGTH "${inventory}" tests ${index} tags)
                if(tags GREATER 0)
                    math(EXPR tag_last "${tags} - 1")
                    foreach(tag RANGE 0 ${tag_last})
                        string(JSON value GET "${inventory}" tests ${index} tags ${tag})
                        string(REPLACE ";" "\\;" value "${value}")
                        list(APPEND values "${value}")
                    endforeach()
                endif()
            endif()
            _baro_code_quote(value "${values}")
            string(APPEND generated " ${key} ${value}")
        endforeach()
        _baro_code_quote(source "${file}")
        string(APPEND generated " BARO_SOURCE_FILE ${source} BARO_SOURCE_LINE ${line}")
        if(BARO_PROPERTIES_COUNT GREATER 0)
            math(EXPR property_last "${BARO_PROPERTIES_COUNT} - 1")
            foreach(property RANGE 0 ${property_last})
                _baro_code_quote(value "${BARO_PROPERTIES_${property}}")
                string(APPEND generated " ${value}")
            endforeach()
        endif()
        string(APPEND generated ")\n")
    endforeach()
endif()
# Readers never see a partial inventory if discovery is interrupted.
file(WRITE "${BARO_MANIFEST}.tmp" "${inventory}")
file(RENAME "${BARO_MANIFEST}.tmp" "${BARO_MANIFEST}")
file(WRITE "${BARO_OUTPUT}.tmp" "${generated}")
file(RENAME "${BARO_OUTPUT}.tmp" "${BARO_OUTPUT}")
include("${BARO_OUTPUT}")
cmake_policy(POP)

endfunction()
_baro_discover()
